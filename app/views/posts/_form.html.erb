<div class="card p-4">
<%= form_with model: post do |form| %>

  <div class="mb-3">
    <strong><%= form.label :title, "タイトル" %></strong><span class="text-danger">*</span>
    <div><%= form.text_field :title, class:"form-control" %></div>
    <% if post.errors[:title].any? %>
      <div class="text-danger"><%= post.errors.full_messages_for(:title).first %></div>
    <% end %>
  </div>
  
  <div class="row mb-3">
  <div class="col-6">
    <strong><%= form.label :start_date, "開始日" %></strong>
    <div><%= form.date_field :start_date, class: "form-control datepicker", placeholder: "---- / -- / --" %></div>
    <% if post.errors[:start_date].any? %>
      <div class="text-danger"><%= post.errors.full_messages_for(:start_date).first %></div>
    <% end %>
  </div>

  <div class="col-6">
    <strong><%= form.label :end_date, "終了日" %></strong><span class="text-danger">*</span>
    <div><%= form.date_field :end_date, class: "form-control datepicker", placeholder: "---- / -- / --" %></div>
    <% if post.errors[:end_date].any? %>
      <div class="text-danger"><%= post.errors.full_messages_for(:end_date).first %></div>
    <% end %>
  </div>
  </div>

  <div class="mb-3">
    <%= form.check_box :all_day %>
    <%= form.label :all_day, "終日の場合はチェックを入れます" %>
  </div>

  <div class="mb-3">
    <strong><%= form.label :body, "スケジュールメモ" %></strong>
    <div><%= form.text_area :body, class:"form-control" %></div>
  </div>
  
  <div class="d-flex justify-content-end">
  <%= link_to "キャンセル", posts_path, class:"btn btn-outline-secondary me-2" %>
  <%= form.submit "保存", class:"btn btn-primary" %>
  </div>

<% end %> 
</div>