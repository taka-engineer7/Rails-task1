<div class="container my-5" style="max-width: 650px;">

<div class="mb-3">
  <%= link_to "← 一覧へ戻る", posts_path, class:"text-decoration-none fw-bold" %>
</div>

<div class="d-flex justify-content-between mb-3">
  <div class="fw-bold"><%= @post.title %></div>
  <%= link_to "編集", edit_post_path(@post), class:"btn btn-outline-primary fw-bold" %>
</div>

<div class="card p-4">
<table class="table align-middle border">
  <tr>
    <th class="bg-body-secondary">開始日</th>           <td><%= @post.start_date %></td>
  </tr>
  <tr>
    <th class="bg-body-secondary">終了日</th>           <td><%= @post.end_date %></td>
  </tr>
  <tr>
    <th class="bg-body-secondary">終日</th>             <td><%= @post.all_day ? "〇" : "" %></td>
  </tr>
  <tr>
    <th class="bg-body-secondary">スケジュールメモ</th>  <td><%= @post.body %></td>
  </tr>
</table>
</div>

</div>